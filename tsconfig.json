{
    "compilerOptions": {
      "target": "es5",
      "module": "es6",
      "rootDir": "./src",
      "outDir": "./jss",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "alwaysStrict": true,
      "forceConsistentCasingInFileNames": true
    },
    "include": [
      "src/**/*"
    ]
  }
  